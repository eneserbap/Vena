# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.whl

# ─── Virtual Environment (uv) ─────────────────────────────────────────────────
.venv/

# ─── Data (tracked by DVC, NOT by Git) ────────────────────────────────────────
# DVC will manage these directories; only the .dvc pointer files are committed.
data/raw/
data/processed/

# ─── Model Artefacts ──────────────────────────────────────────────────────────
*.pt
*.pth
outputs/        # Hydra output directory
multirun/       # Hydra multirun output directory

# ─── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# ─── Environment Variables ────────────────────────────────────────────────────
.env
.env.*

# ─── Testing & Coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─── Type Checking ────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
